{
  "name": "aqarak",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "synth": "pnpm --filter @aqarak/cdk synth",
    "verify": "pnpm format:check && turbo run typecheck lint test"
  },
  "devDependencies": {
    "turbo": "2.11.4",
    "prettier": "3.9.9",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "esbuild": "0.28.2",
    "vitest": "catalog:"
  }
}
