# Select mock for single-process development or http for the deployed API.
AQARAK_API_MODE=
# Set an HTTPS API base URL, with HTTP permitted only on loopback hosts.
AQARAK_API_BASE_URL=
# Provide at least 32 characters in production for session CSRF derivation.
AQARAK_SESSION_SECRET=
# Set the public application origin when forwarded request headers are not authoritative.
AQARAK_APP_ORIGIN=
