{
  "name": "@aqarak/cdk",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth --quiet",
    "outputs:dev": "tsx scripts/write-outputs.ts",
    "deploy:dev": "cdk deploy \"Dev/*\" --require-approval never --concurrency 4 --outputs-file cdk.out/dev-outputs.json",
    "migrate:dev": "tsx scripts/migrate-dev.ts",
    "smoke:dev": "tsx scripts/smoke-dev.ts"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "catalog:",
    "@aqarak/config": "workspace:*",
    "vitest": "catalog:",
    "aws-cdk": "2.1143.0",
    "tsx": "4.23.15",
    "@types/node": "24.19.0",
    "eslint-config-prettier": "10.1.8"
  },
  "dependencies": {
    "aws-cdk-lib": "2.271.0",
    "constructs": "10.8.1",
    "cdk-nag": "3.0.2",
    "zod": "catalog:"
  }
}
